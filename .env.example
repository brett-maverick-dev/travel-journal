# ── Required ───────────────────────────────────────────────────────────
# On GoDaddy Node.js Hosting these two go in "secrets" at import time.

# Signs session cookies. Generate one: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# SQLite under public/assets survives redeploys on GoDaddy Node.js Hosting.
# For anything beyond one instance, point this at managed Postgres and change
# the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./public/assets/data/app.db"

# ── Optional ───────────────────────────────────────────────────────────

# Leave blank and verification/reset codes print to the runtime log instead of sending.
# Full SMTP connection string — URL-encode special characters in the password.
#   Gmail (use an App Password, not your login password):
#     SMTP_URL="smtps://you%40gmail.com:app-password@smtp.gmail.com:465"
#   Generic SMTP:
#     SMTP_URL="smtps://user:pass@smtp.yourprovider.com:465"
SMTP_URL=""
MAIL_FROM="Meridian <no-reply@example.com>"

# Where photos are written, and the URL prefix they are served under.
# Defaults already match the persistent directory — override only if you move it.
UPLOAD_DIR="public/assets/uploads"
UPLOAD_PUBLIC_PREFIX="/assets/uploads"

# The platform sets PORT itself. Only set this for local runs on another port.
# PORT=3000
