# ── Required ───────────────────────────────────────────────────────────
# On GoDaddy Node.js Hosting, SESSION_SECRET goes in "secrets" at import time.
# The database variables below are provided by the platform's managed MySQL.

# Signs session cookies. Generate one: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# MySQL. On GoDaddy, server.mjs builds the URL from the managed database's
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD, unless DATABASE_URL is
# already a mysql:// URL. Locally, point it at your own MySQL (URL-encode
# special characters in the password):
DATABASE_URL="mysql://trekkster:password@127.0.0.1:3306/trekkster"
# DB_HOST=""
# DB_PORT="3306"
# DB_NAME=""
# DB_USER=""
# DB_PASSWORD=""

# ── Optional ───────────────────────────────────────────────────────────

# Leave blank and verification/reset codes print to the runtime log instead of sending.
# Full SMTP connection string — URL-encode special characters (the @ in an
# email-address username becomes %40).
#   Office 365 / Outlook (needs "Authenticated SMTP" enabled for the mailbox in
#   the admin center, and an App Password if MFA is on — requireTLS is required,
#   plain smtps:// on 465 will not work):
#     SMTP_URL="smtp://you%40yourdomain.com:app-password@smtp.office365.com:587?requireTLS=true"
#   Gmail (use an App Password, not your login password):
#     SMTP_URL="smtps://you%40gmail.com:app-password@smtp.gmail.com:465"
#   Generic SMTP:
#     SMTP_URL="smtps://user:pass@smtp.yourprovider.com:465"
SMTP_URL=""
MAIL_FROM="Trekkster <no-reply@example.com>"

# Comma-separated emails that get admin access (/admin) even before anyone has
# the isAdmin flag set in the database — this is how you make yourself the
# first admin. Once you're in, you can promote/demote other accounts from the
# admin panel itself; this list only matters for bootstrapping.
ADMIN_EMAILS=""

# Where photos are written, and the URL prefix they are served under.
# Defaults already match the persistent directory — override only if you move it.
# Keep the prefix on /api/photo: Next.js only serves public/ files that existed
# when the server started, so photos uploaded later 404 under /assets/uploads/.
UPLOAD_DIR="public/assets/uploads"
UPLOAD_PUBLIC_PREFIX="/api/photo?f="

# Set to a snapshot's file name (from /admin/backups) to load it on the next
# boot. Only runs into an EMPTY database, so it can't overwrite live data.
# RESTORE_BACKUP="app-2026-01-01T00-00-00-000Z.json"

# The platform sets PORT itself. Only set this for local runs on another port.
# PORT=3000
