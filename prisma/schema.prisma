generator client {
  provider = "prisma-client-js"
}

datasource db {
  // GoDaddy Node.js Hosting gives every published app a managed MySQL
  // database, and it outlives deploys — unlike files on the app's disk.
  // server.mjs builds DATABASE_URL from the platform's DB_* variables.
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  handle            String      @unique
  passwordHash      String
  verified          Boolean     @default(false)
  isAdmin           Boolean     @default(false)
  verifyCode        String?
  codeExpires       DateTime?
  verifyAttempts    Int         @default(0) // wrong guesses against the current verifyCode
  resetCode         String?
  resetExpires      DateTime?
  resetAttempts     Int         @default(0) // wrong guesses against the current resetCode
  name              String      @default("")
  avatarUrl         String?     @db.VarChar(1024)
  homeCity          String      @default("")
  favoritePlace     String      @default("")
  bio               String      @db.Text // TEXT can't take a DB default in MySQL — lib/db.js fills ""
  facebookUrl       String      @default("") @db.VarChar(1024)
  instagramUrl      String      @default("") @db.VarChar(1024)
  tiktokUrl         String      @default("") @db.VarChar(1024)
  xUrl              String      @default("") @db.VarChar(1024)
  youtubeUrl        String      @default("") @db.VarChar(1024)
  pinterestUrl      String      @default("") @db.VarChar(1024)
  createdAt         DateTime    @default(now())
  trips             Trip[]
  buddiesSent       Buddy[]     @relation("BuddyRequester")
  buddiesRecv       Buddy[]     @relation("BuddyAddressee")
  tripsSharedWithMe TripBuddy[]
  comments          Comment[]
  photosUploaded    Photo[]
}

// A friend request / connection between two users — "Travel Buddies".
// requesterId is whoever *initiated* the current row: who sent the request,
// or who did the blocking. At most one row should exist per pair of users
// (checked in app code, not the DB, since which side is requester can flip
// when a block is applied) — see findBuddyRow() in app/actions.js.
model Buddy {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("BuddyRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("BuddyAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING | ACCEPTED | BLOCKED
  createdAt   DateTime @default(now())

  @@index([requesterId])
  @@index([addresseeId])
}

model Trip {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(500)
  country      String        @default("")
  visibility   String        @default("PRIVATE") // PRIVATE | PUBLIC
  startDate    DateTime
  endDate      DateTime
  coverUrl     String?       @db.VarChar(1024)
  // How the cover is framed: a zoom (1 = just fills the frame) about a focus
  // point given as percentages of the image (50/50 = centred).
  coverZoom    Float         @default(1)
  coverX       Float         @default(50)
  coverY       Float         @default(50)
  // Where the trip starts from. Kept off the destination list on purpose — it
  // gets no pages of its own; the first destination's transport describes
  // the leg from here.
  departureCity String       @default("")
  departureDate DateTime?
  departureLat  Float? // geocoded from departureCity, for the map's starting pin
  departureLng  Float?
  // Where the departure journey lands (a city or airport, e.g. "NRT"),
  // before the first destination. Like the departure, it gets no pages.
  arrivalCity   String       @default("") @db.VarChar(500)
  arrivalLat    Float?
  arrivalLng    Float?
  // The journey home at the end of the trip, mirroring the departure:
  // where it leaves from (a city or airport, e.g. "KIX"; blank = the last
  // destination), when, and where it lands (blank = the departure city).
  returnDate     DateTime?
  returnFromCity String     @default("") @db.VarChar(500)
  returnFromLat  Float?
  returnFromLng  Float?
  returnToCity   String     @default("") @db.VarChar(500)
  returnToLat    Float?
  returnToLng    Float?
  layovers      Layover[]
  createdAt    DateTime      @default(now())
  destinations Destination[]
  pages        Page[]
  buddies      TripBuddy[]

  @@index([userId])
}

// A travel buddy added to this trip, at an access level (lib/permissions.js):
// FULL (everything but deleting the trip), EDITOR (add and change, no
// deleting, no public/private, no people), CONTRIBUTOR (add photos and
// comment) or VIEWER (read and comment — useful for private trips). Only
// actual travel buddies of whoever adds them can be added.
model TripBuddy {
  id      String   @id @default(cuid())
  tripId  String
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String   @default("EDITOR") @db.VarChar(16)
  addedAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

// A stop on the journey there (leg DEPARTURE: departure city → arrival) or
// home (leg RETURN) — drawn on the map's route, in position order, but with
// no pages of its own.
model Layover {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  leg      String @default("DEPARTURE") @db.VarChar(16) // DEPARTURE | RETURN
  name     String @db.VarChar(500) // a city or airport, e.g. "LAX"
  lat      Float?
  lng      Float?
  position Int    @default(0)

  @@index([tripId])
}

model Destination {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(500)
  lat       Float?
  lng       Float?
  arrive    DateTime
  depart    DateTime
  transport String   @default("Flight") // Flight | Train | Bus | Rental car | Ferry | On foot
  detail    String   @default("") @db.VarChar(500) // "NH106 · 11h 40m"
  position  Int      @default(0)

  @@index([tripId])
}

model Page {
  id       String   @id @default(cuid())
  tripId   String
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind     String   @default("DAY") // DAY | ACTIVITY
  // Set on the day pages for the journey there (DEPARTURE) or home (RETURN),
  // which are grouped under "Leaving from" / "Return" instead of a destination.
  leg      String?  @db.VarChar(16)
  parentId String? // set on ACTIVITY pages: the day they belong to
  title    String   @default("Untitled page") @db.VarChar(500)
  date     DateTime
  time     String? // activity pages: "14:20"
  place    String   @default("")
  weather  String   @default("")
  spend    String   @default("")
  steps    String   @default("")
  notes    String   @db.Text // TEXT: default "" comes from lib/db.js
  tags     String   @db.Text // comma separated; default "" comes from lib/db.js
  hidden   Boolean  @default(false)
  position Int      @default(0)
  photos   Photo[]
  comments Comment[]

  @@index([tripId])
  @@index([parentId])
}

model Photo {
  id       String @id @default(cuid())
  pageId   String
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  url      String @db.VarChar(1024)
  caption  String @db.Text // default "" comes from lib/db.js
  position Int    @default(0)
  // Clockwise turn to display it upright: 0, 90, 180 or 270. Applied when
  // shown (components/PhotoImage.jsx); the file itself is never re-encoded.
  rotation Int    @default(0)
  // Who added it — Contributors may only change their own photos. Null for
  // photos from before this was recorded; those count as the trip owner's.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([pageId])
}

// A comment on a page, by anyone on the trip (any access level).
model Comment {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text // TEXT: no DB default; always provided
  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([userId])
}
