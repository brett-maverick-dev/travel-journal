generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite is fine for one instance with the file under public/assets (persistent
  // on GoDaddy Node.js Hosting). Switch to "postgresql" for multiple instances.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  handle        String   @unique
  passwordHash  String
  verified      Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  verifyCode    String?
  codeExpires   DateTime?
  resetCode     String?
  resetExpires  DateTime?
  name          String   @default("")
  avatarUrl     String?
  homeCity      String   @default("")
  favoritePlace String   @default("")
  bio           String   @default("")
  facebookUrl   String   @default("")
  instagramUrl  String   @default("")
  tiktokUrl     String   @default("")
  xUrl          String   @default("")
  youtubeUrl    String   @default("")
  pinterestUrl  String   @default("")
  createdAt     DateTime @default(now())
  trips         Trip[]
  buddiesSent   Buddy[]  @relation("BuddyRequester")
  buddiesRecv   Buddy[]  @relation("BuddyAddressee")
}

// A friend request / connection between two users — "Travel Buddies".
// requesterId is whoever *initiated* the current row: who sent the request,
// or who did the blocking. At most one row should exist per pair of users
// (checked in app code, not the DB, since which side is requester can flip
// when a block is applied) — see findBuddyRow() in app/actions.js.
model Buddy {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("BuddyRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("BuddyAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING | ACCEPTED | BLOCKED
  createdAt   DateTime @default(now())

  @@index([requesterId])
  @@index([addresseeId])
}

model Trip {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  country      String        @default("")
  visibility   String        @default("PRIVATE") // PRIVATE | PUBLIC
  startDate    DateTime
  endDate      DateTime
  coverUrl     String?
  createdAt    DateTime      @default(now())
  destinations Destination[]
  pages        Page[]

  @@index([userId])
}

model Destination {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  lat       Float?
  lng       Float?
  arrive    DateTime
  depart    DateTime
  transport String   @default("Flight") // Flight | Train | Bus | Rental car | Ferry | On foot
  detail    String   @default("")       // "NH106 · 11h 40m"
  position  Int      @default(0)

  @@index([tripId])
}

model Page {
  id       String   @id @default(cuid())
  tripId   String
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind     String   @default("DAY") // DAY | ACTIVITY
  parentId String?                 // set on ACTIVITY pages: the day they belong to
  title    String   @default("Untitled page")
  date     DateTime
  time     String?                 // activity pages: "14:20"
  place    String   @default("")
  weather  String   @default("")
  spend    String   @default("")
  steps    String   @default("")
  notes    String   @default("")
  tags     String   @default("")   // comma separated
  hidden   Boolean  @default(false)
  position Int      @default(0)
  photos   Photo[]

  @@index([tripId])
  @@index([parentId])
}

model Photo {
  id       String  @id @default(cuid())
  pageId   String
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  url      String
  caption  String  @default("")
  position Int     @default(0)

  @@index([pageId])
}
